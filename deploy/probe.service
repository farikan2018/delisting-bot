[Unit]
Description=Delisting latency probe (compares announcement sources)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/delisting-bot
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/delisting-bot/.venv/bin/python /home/ubuntu/delisting-bot/probe.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
