# Приклад конфігу. Скопіюй у .env і встав свої значення.
TELEGRAM_BOT_TOKEN=встав_токен_від_BotFather
TELEGRAM_CHAT_ID=встав_свій_chat_id

# Poll-інтервал анонсів Binance, секунд
POLL_INTERVAL=3

# Біржі виконання (пріоритет зліва направо). Для dry-run ключі НЕ потрібні.
VENUE_PRIORITY=bybit,mexc
# Bybit (основна). Права: тільки ф'ючерси/деривативи, БЕЗ withdrawal.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# MEXC (резерв).
MEXC_API_KEY=встав_api_key
MEXC_API_SECRET=встав_secret_key

# Торгові параметри (Strategy v2). DRY_RUN=1 → без реальних ордерів (симуляція).
DRY_RUN=1
POSITION_MARGIN_USDT=100
LEVERAGE=3
# Маржа реального тест-шорта через /test_short (працює навіть при DRY_RUN=1)
TEST_MARGIN_USDT=2
# Вхід: не входити, якщо за REF_LOOKBACK_MIN хв уже впало більше ніж MAX_ALREADY_DROP_PCT%. 0=вимк.
REF_LOOKBACK_MIN=5
MAX_ALREADY_DROP_PCT=8
# Вихід (у % від маржі)
TAKE_PROFIT_MARGIN_PCT=30
STOP_LOSS_MARGIN_PCT=30
MAX_HOLD_MINUTES=45
MAX_CONCURRENT=3
# Keep-alive конектів до бірж (сек), щоб бойовий ордер не платив холодний TLS-старт. 0=вимк.
KEEPALIVE_SEC=30
